{
  "name": "@vitalscope/sdk",
  "version": "0.2.1",
  "description": "Real user monitoring for Core Web Vitals and JavaScript errors, with zero runtime dependencies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emircanbakar/vitalscope.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/emircanbakar/vitalscope/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/emircanbakar/vitalscope/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./attribution": {
      "types": "./dist/attribution.d.mts",
      "default": "./dist/attribution.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "default": "./dist/next.mjs"
    },
    "./vitalscope.iife.js": "./dist/vitalscope.iife.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "size": "size-limit"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitalscope/protocol": "workspace:*",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
