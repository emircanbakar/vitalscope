{
  "name": "@vitalscope/protocol",
  "version": "0.1.0",
  "description": "Vitalscope event protocol: schemas, thresholds and limits shared by the SDK and the ingest service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emircanbakar/vitalscope.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/emircanbakar/vitalscope/tree/main/packages/protocol#readme",
  "bugs": "https://github.com/emircanbakar/vitalscope/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
