# Canlı ortam değişkenleri. Değerler repoya yazılmaz; yerel geliştirme için infra/dev.env kullanılır.

# Postgres bağlantısı
DATABASE_URL=

# ClickHouse adresi
CLICKHOUSE_URL=
# Migration'ları çalıştıran ve kullanıcıları oluşturan yönetici
CLICKHOUSE_ADMIN_USER=
CLICKHOUSE_ADMIN_PASSWORD=
# Ingest'in sadece INSERT yetkili kullanıcısı
CLICKHOUSE_WRITE_USER=
CLICKHOUSE_WRITE_PASSWORD=
# Dashboard'un salt okunur kullanıcısı
CLICKHOUSE_READ_USER=
CLICKHOUSE_READ_PASSWORD=
