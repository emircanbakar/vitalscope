{
  "name": "@vitalscope/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode attribution",
    "preview": "vite preview --port 4173 --strictPort",
