  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitalscope/protocol": "workspace:*",
    "@vitalscope/sdk": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "web-vitals": "6.2.3"
  }
}
